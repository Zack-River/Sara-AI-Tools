\u0644\u0627\u062a \u0627\u0644\u0639\u0645\u0631\u0629 \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0645\u0646 \u0627\u0644\u0631\u064a\u0627\u0636. \u0625\u0644\u064a\u0643 \u0628\u0639\u0636 \u0623\u0628\u0631\u0632\u0647\u0627:<\/p>\n\n\n\n<ol class=\"wp-block-list\">\n<li><strong>\u0627\u0644\u0632\u0627\u0626\u0631\u064a\u0646 (alzaarin.net)<\/strong>: \u062a\u0642\u062f\u0645 \u0628\u0627\u0642\u0627\u062a \u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 \u0648VIP \u0645\u0639 \u062e\u064a\u0627\u0631\u0627\u062a \u0645\u062a\u0646\u0648\u0639\u0629 \u0644\u0644\u0625\u0642\u0627\u0645\u0629 \u0648\u0627\u0644\u0646\u0642\u0644 .<\/li>\n\n\n\n<li><strong>\u062a\u0628\u064a\u0627\u0646 \u0644\u0644\u0639\u0645\u0631\u0629 \u0648\u0627\u0644\u0632\u064a\u0627\u0631\u0629 (tebyantravel.com)<\/strong>: \u062a\u0634\u062a\u0647\u0631 \u0628\u0631\u062d\u0644\u0627\u062a\u0647\u0627 \u0627\u0644\u0641\u0627\u062e\u0631\u0629 \u0648\u062e\u062f\u0645\u0627\u062a\u0647\u0627 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0627\u0644\u0645\u062a\u0645\u064a\u0632\u0629 .<\/li>\n\n\n\n<li><strong>\u0642\u0627\u0641\u0644\u0629 \u0627\u0644\u0631\u064a\u0627\u0646 (hamalat-elrayan.com)<\/strong>: \u062a\u0648\u0641\u0631 \u062d\u062c\u0648\u0632\u0627\u062a \u0634\u0627\u0645\u0644\u0629 \u0645\u0639 \u0645\u0631\u0634\u062f\u064a\u0646 \u0645\u062a\u062e\u0635\u0635\u064a\u0646 .<\/li>\n\n\n\n<li><strong>\u062d\u0645\u0644\u0647 \u0627\u0644\u0639\u0645\u0631\u0629 (hamalatumrah.com)<\/strong>: \u062a\u0642\u062f\u0645 \u0639\u0631\u0648\u0636\u0627\u064b \u062a\u0646\u0627\u0641\u0633\u064a\u0629 \u0645\u0639 \u062e\u064a\u0627\u0631\u0627\u062a \u0645\u062a\u0639\u062f\u062f\u0629 \u0644\u0644\u0641\u0646\u0627\u062f\u0642 .<\/li>\n\n\n\n<li><strong>\u0645\u0646\u0635\u0629 \u0636\u064a\u0648\u0641 (alrehabumrah.com)<\/strong>: \u062a\u0645\u062a\u0627\u0632 \u0628\u0646\u0638\u0627\u0645 \u062d\u062c\u0632 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0633\u0647\u0644 \u0648\u0645\u0631\u0646 .<\/li>\n<\/ol>\n\n\n\n<h2 class=\"wp-block-heading\">4. \u0643\u064a\u0641\u064a\u0629 \u062d\u062c\u0632 \u0631\u062d\u0644\u0629 \u0639\u0645\u0631\u0629 \u064a\u0648\u0645\u064a\u0629 \u0645\u0646 \u0627\u0644\u0631\u064a\u0627\u0636<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u062a\u0642\u062f\u0645 \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0643\u0627\u062a\u0628 \u0637\u0631\u0642\u0627\u064b \u0633\u0647\u0644\u0629 \u0648\u0645\u062a\u0639\u062f\u062f\u0629 \u0644\u0644\u062d\u062c\u0632:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u0627\u0644\u062d\u062c\u0632 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a<\/strong>: \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0623\u0648 \u0645\u0646\u0635\u0627\u062a \u0627\u0644\u062d\u062c\u0632 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647\u0645 .<\/li>\n\n\n\n<li><strong>\u0627\u0644\u062d\u062c\u0632 \u0639\u0628\u0631 \u0627\u0644\u0648\u0627\u062a\u0633\u0627\u0628<\/strong>: \u0648\u0647\u0648 \u062e\u064a\u0627\u0631 \u0633\u0631\u064a\u0639 \u0648\u0634\u0627\u0626\u0639 \u0644\u0644\u062d\u062c\u0632 \u0627\u0644\u0641\u0648\u0631\u064a .<\/li>\n\n\n\n<li><strong>\u0627\u0644\u062d\u062c\u0632 \u0627\u0644\u0645\u0628\u0627\u0634\u0631<\/strong>: \u0639\u0646 \u0637\u0631\u064a\u0642 \u0632\u064a\u0627\u0631\u0629 \u0645\u0643\u0627\u062a\u0628\u0647\u0645 \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u062e\u0627\u0635\u0629 \u0641\u064a \u0645\u0646\u0637\u0642\u0629 <strong>\u0627\u0644\u0628\u0637\u062d\u0627\u0621<\/strong> \u0627\u0644\u062a\u064a \u062a\u062a\u0631\u0643\u0632 \u0641\u064a\u0647\u0627 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0645\u0643\u0627\u062a\u0628 \u0627\u0644\u0639\u0645\u0631\u0629 .<\/li>\n\n\n\n<li><strong>\u0627\u0644\u062f\u0641\u0639<\/strong>: \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0643\u0627\u062a\u0628 \u062a\u062a\u064a\u062d \u062e\u064a\u0627\u0631 <strong>\u0627\u0644\u062f\u0641\u0639 \u0639\u0646\u062f \u0627\u0644\u0648\u0635\u0648\u0644<\/strong> .<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\">5. \u0646\u0635\u0627\u0626\u062d \u0645\u0647\u0645\u0629 \u0642\u0628\u0644 \u0627\u0644\u062d\u062c\u0632 \u0648\u0627\u0644\u0633\u0641\u0631<\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u0623\u062e\u0644\u0635 \u0627\u0644\u0646\u064a\u0629<\/strong>: \u0627\u062c\u0639\u0644 \u0646\u064a\u062a\u0643 \u062e\u0627\u0644\u0635\u0629 \u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0648\u0623\u062a\u0642\u0646 \u0627\u0644\u0639\u0628\u0627\u062f\u0629 \u0628\u0639\u064a\u062f\u0627\u064b \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0621 .<\/li>\n\n\n\n<li><strong>\u062a\u0639\u0644\u0651\u0645 \u0627\u0644\u0645\u0646\u0627\u0633\u0643<\/strong>: \u062a\u0623\u0643\u062f \u0645\u0646 \u062a\u0639\u0644\u0645 \u0645\u0646\u0627\u0633\u0643 \u0627\u0644\u0639\u0645\u0631\u0629 \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d \u0645\u0646 \u0645\u0635\u0627\u062f\u0631 \u0645\u0648\u062b\u0648\u0642\u0629 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631 .<\/li>\n\n\n\n<li><strong>\u062c\u0647\u0651\u0632 \u0645\u0633\u062a\u0644\u0632\u0645\u0627\u062a\u0643<\/strong>: \u0627\u062d\u0636\u0631 \u0645\u0639\u0643 \u0627\u0644\u0648\u062b\u0627\u0626\u0642 \u0627\u0644\u062b\u0628\u0648\u062a\u064a\u0629 (\u0647\u0648\u064a\u0629\/\u062c\u0648\u0627\u0632 \u0633\u0641\u0631)\u060c \u0645\u0644\u0627\u0628\u0633 \u0645\u0646\u0627\u0633\u0628\u0629\u060c \u0623\u062f\u0648\u064a\u0629 \u0634\u062e\u0635\u064a\u0629\u060c \u0645\u0635\u062d\u0641\u060c \u0648\u0633\u062c\u0627\u062f\u0629 \u0635\u0644\u0627\u0629 .<\/li>\n\n\n\n<li><strong>\u0627\u062e\u062a\u0631 \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629<\/strong>: \u0642\u0627\u0631\u0646 \u0628\u064a\u0646 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0648\u0627\u0642\u0631\u0622 reviews \u0648\u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0627\u0644\u0622\u062e\u0631\u064a\u0646 \u0642\u0628\u0644 \u0627\u062a\u062e\u0627\u0630 \u0627\u0644\u0642\u0631\u0627\u0631 .<\/li>\n\n\n\n<li><strong>\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0631\u062d\u0644\u0629<\/strong>: \u062a\u0623\u0643\u062f \u0645\u0646 \u0646\u0642\u0637\u0629 \u0648\u062a\u0648\u0642\u064a\u062a \u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642\u060c \u0646\u0648\u0639 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u0645\u0648\u0642\u0639\u0647\u060c \u0648\u0646\u0648\u0639\u064a\u0629 \u0627\u0644\u0628\u0627\u0635 .<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\">6. \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629<\/h2>\n\n\n\n<h3 class=\"wp-block-heading\">? \u0645\u0627 \u0647\u064a \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0634\u0645\u0648\u0644\u0629 \u0639\u0627\u062f\u0629 \u0641\u064a \u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0639\u0645\u0631\u0629<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">\u062a\u0634\u0645\u0644 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629: \u0627\u0644\u0646\u0642\u0644 \u0628\u0628\u0627\u0635\u0627\u062a \u0645\u0643\u064a\u0641\u0629\u060c \u0627\u0644\u0625\u0642\u0627\u0645\u0629 \u0641\u064a \u0641\u0646\u062f\u0642\u060c \u0645\u0631\u0634\u062f \u0645\u062a\u062e\u0635\u0635\u060c \u0648\u062a\u0623\u0645\u064a\u0646 \u0635\u062d\u064a. \u062a\u062e\u062a\u0644\u0641 \u0627\u0644\u0648\u062c\u0628\u0627\u062a \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u064a\u0629 \u062d\u0633\u0628 \u0646\u0648\u0639 \u0627\u0644\u0628\u0627\u0642\u0629 .<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">? \u0647\u0644 \u064a\u0645\u0643\u0646 \u0627\u0644\u0625\u0644\u063a\u0627\u0621 \u0623\u0648 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u062d\u062c\u0632<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">\u0646\u0639\u0645\u060c \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0643\u0627\u062a\u0628 \u062a\u062a\u064a\u062d \u0645\u0631\u0648\u0646\u0629 \u0641\u064a <strong>\u062a\u0639\u062f\u064a\u0644 \u0645\u0648\u0639\u062f \u0627\u0644\u0631\u062d\u0644\u0629 \u0623\u0648 \u0646\u0648\u0639 \u0627\u0644\u0628\u0627\u0642\u0629<\/strong> \u0642\u0628\u0644 \u0645\u0648\u0639\u062f \u0627\u0644\u0633\u0641\u0631 \u0628\u0641\u062a\u0631\u0629 \u0643\u0627\u0641\u064a\u0629. ** \u0633\u064a\u0627\u0633\u0627\u062a \u0627\u0644\u0625\u0644\u063a\u0627\u0621 ** \u062a\u062e\u062a\u0644\u0641 \u0645\u0646 \u0645\u0643\u062a\u0628 \u0644\u0622\u062e\u0631\u060c \u0648\u0642\u062f \u064a\u062a\u0636\u0645\u0646 \u0628\u0639\u0636\u0647\u0627 \u0627\u0633\u062a\u0631\u062f\u0627\u062f\u0627\u064b \u062c\u0632\u0626\u064a\u0627\u064b \u0623\u0648 \u0643\u0627\u0645\u0644\u0627\u064b \u062d\u0633\u0628 \u0627\u0644\u062a\u0648\u0642\u064a\u062a .<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">? \u0645\u0627 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u0628\u0627\u0635 \u0627\u0644\u0639\u0627\u062f\u064a \u0648\u0628\u0627\u0635 VIP<\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u0627\u0644\u0628\u0627\u0635 \u0627\u0644\u0639\u0627\u062f\u064a (\u0627\u0642\u062a\u0635\u0627\u062f\u064a)<\/strong>: 4 \u0635\u0641\u0648\u0641 \u0645\u0642\u0627\u0639\u062f\u060c \u0645\u0631\u064a\u062d \u0648\u0645\u0643\u064a\u0641.<\/li>\n\n\n\n<li><strong>\u0628\u0627\u0635 VIP<\/strong>: 3 \u0635\u0641\u0648\u0641 \u0645\u0642\u0627\u0639\u062f \u0641\u0642\u0637\u060c \u0645\u0645\u0627 \u064a\u0648\u0641\u0631 \u0645\u0633\u0627\u062d\u0629 \u0634\u062e\u0635\u064a\u0629 \u0623\u0643\u0628\u0631\u060c \u0645\u0642\u0627\u0639\u062f \u0623\u0648\u0633\u0639 \u0648\u0623\u0643\u062b\u0631 \u0631\u0627\u062d\u0629 (\u063a\u0627\u0644\u0628\u0627\u064b \u062c\u0644\u062f\u064a\u0629)\u060c \u0648\u062e\u062f\u0645\u0627\u062a \u0631\u0627\u0642\u064a\u0629 .<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\">\u062e\u0627\u062a\u0645\u0629<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u0623\u062f\u0627\u0621 \u0627\u0644\u0639\u0645\u0631\u0629 \u0647\u0648 \u062d\u0644\u0645 \u064a\u0631\u0627\u0648\u062f \u0627\u0644\u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0645\u0633\u0644\u0645\u064a\u0646\u060c \u0648\u0642\u062f \u0633\u0647\u0644\u062a ** \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0645\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 ** \u062a\u062d\u0642\u064a\u0642 \u0647\u0630\u0627 \u0627\u0644\u062d\u0644\u0645 \u0628\u0634\u0643\u0644 \u0643\u0628\u064a\u0631. \u0633\u0648\u0627\u0621 \u0643\u0646\u062a \u062a\u0628\u062d\u062b \u0639\u0646 ** \u0631\u062d\u0644\u0629 \u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 ** \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0645\u064a\u0632\u0627\u0646\u064a\u062a\u0643\u060c \u0623\u0648 ** \u062a\u062c\u0631\u0628\u0629 VIP \u0641\u0627\u062e\u0631\u0629 ** \u062a\u0633\u062a\u062d\u0642\u0647\u0627\u060c \u0641\u0625\u0646 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0623\u0645\u0627\u0645\u0643 \u0645\u062a\u0646\u0648\u0639\u0629 \u0648\u0648\u0641\u064a\u0631\u0629. \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0647\u0648 \u0627\u0644\u0628\u062d\u062b \u0627\u0644\u062c\u064a\u062f\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0639\u0631\u0648\u0636\u060c \u0648\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0643\u062a\u0628 \u0627\u0644\u0645\u0648\u062b\u0648\u0642 \u0627\u0644\u0630\u064a \u064a\u0636\u0645\u0646 \u0644\u0643 \u0631\u062d\u0644\u0629 \u0622\u0645\u0646\u0629 \u0648\u0645\u0631\u064a\u062d\u0629 \u062a\u062a\u064a\u062d \u0644\u0643 \u0627\u0644\u062a\u0641\u0631\u063a 