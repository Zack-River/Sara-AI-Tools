\u062a\u062d\u0642\u064a\u0642 \u0647\u0630\u0647 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0631\u0648\u062d\u0627\u0646\u064a\u0629 \u0628\u0633\u0644\u0627\u0633\u0629 \u0648\u0631\u0636\u0627\u060c \u064a\u0628\u0631\u0632 <strong>\u0627\u062e\u062a\u064a\u0627\u0631 \u0623\u0641\u0636\u0644 \u0634\u0631\u0643\u0629 \u0639\u0645\u0631\u0629 \u0648\u0632\u064a\u0627\u0631\u0629<\/strong> \u0643\u0623\u0647\u0645 \u0642\u0631\u0627\u0631 \u064a\u062c\u0628 \u0627\u062a\u062e\u0627\u0630\u0647. \u0645\u0639 \u062a\u0639\u062f\u062f \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0648\u0627\u0644\u0645\u0643\u0627\u062a\u0628 \u0627\u0644\u0645\u062a\u062e\u0635\u0635\u0629 \u0641\u064a \u062a\u0646\u0638\u064a\u0645 \u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0639\u0645\u0631\u0629\u060c \u064a\u0635\u0628\u062d \u0645\u0646 \u0627\u0644\u0635\u0639\u0628 \u0623\u062d\u064a\u0627\u0646\u064b\u0627 \u0627\u0644\u062a\u0645\u064a\u064a\u0632 \u0628\u064a\u0646\u0647\u0627 \u0648\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0623\u0641\u0636\u0644. \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u062f\u0644\u064a\u0644 \u0627\u0644\u0634\u0627\u0645\u0644\u060c \u0633\u0646\u0633\u062a\u0639\u0631\u0636 \u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u062e\u062a\u064a\u0627\u0631 <strong>\u0623\u0641\u0636\u0644 \u0634\u0631\u0643\u0629 \u0639\u0645\u0631\u0629<\/strong>\u060c \u0648\u0646\u0642\u062f\u0645 \u0646\u0638\u0631\u0629 \u0639\u0644\u0649 \u0623\u0628\u0631\u0632 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0645\u062a\u0627\u062d\u0629\u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0646\u0635\u0627\u0626\u062d \u0639\u0645\u0644\u064a\u0629 \u0644\u0636\u0645\u0627\u0646 \u0631\u062d\u0644\u0629 \u0639\u0645\u0631\u0629 \u0645\u0645\u064a\u0632\u0629 \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u0645\u0634\u0643\u0644\u0627\u062a \u0627\u0644\u0634\u0627\u0626\u0639\u0629.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">1. \u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u062e\u062a\u064a\u0627\u0631 \u0623\u0641\u0636\u0644 \u0634\u0631\u0643\u0629 \u0639\u0645\u0631\u0629 \u0648\u0632\u064a\u0627\u0631\u0629<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0639\u062f\u0629 \u0639\u0648\u0627\u0645\u0644 \u064a\u062c\u0628 \u062a\u0648\u0641\u0631\u0647\u0627 \u0644\u0636\u0645\u0627\u0646 \u0631\u062d\u0644\u0629 \u0622\u0645\u0646\u0629 \u0648\u0645\u0631\u064a\u062d\u0629:<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">\u0623. <strong>\u0627\u0644\u062a\u0631\u062e\u064a\u0635 \u0648\u0627\u0644\u0633\u0645\u0639\u0629<\/strong> \u2696\ufe0f<\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 \u0627\u0644\u0634\u0631\u0643\u0629 \u0645\u0631\u062e\u0635\u0629 \u0631\u0633\u0645\u064a\u064b\u0627 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u062c\u0647\u0627\u062a \u0627\u0644\u0645\u062e\u062a\u0635\u0629 \u0641\u064a \u0628\u0644\u062f\u0643 (\u0645\u062b\u0644 <strong>\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0633\u064a\u0627\u062d\u0629<\/strong> \u0623\u0648 <strong>\u0647\u064a\u0626\u0629 \u0627\u0644\u062d\u062c \u0648\u0627\u0644\u0639\u0645\u0631\u0629<\/strong>). \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062a\u0631\u062e\u064a\u0635 \u0639\u0628\u0631 \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0644\u0647\u0630\u0647 \u0627\u0644\u062c\u0647\u0627\u062a .<\/li>\n\n\n\n<li>\u0627\u0628\u062d\u062b \u0639\u0646 <strong>\u0634\u0647\u0627\u062f\u0627\u062a \u0627\u0644\u0639\u0645\u0644\u0627\u0621<\/strong> \u0648\u062a\u0642\u064a\u064a\u0645\u0627\u062a\u0647\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u0629. \u0627\u0644\u0634\u0647\u0627\u062f\u0627\u062a \u0627\u0644\u0625\u064a\u062c\u0627\u0628\u064a\u0629 \u0645\u0646 \u062d\u062c\u0627\u062c \u0648\u0645\u0639\u062a\u0645\u0631\u064a\u0646 \u0633\u0627\u0628\u0642\u064a\u0646 \u0645\u0624\u0634\u0631 \u0642\u0648\u064a \u0639\u0644\u0649 \u062c\u0648\u062f\u0629 \u0627\u0644\u062e\u062f\u0645\u0629 .<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\">\u0628. <strong>\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0627\u0644\u0634\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629<\/strong> \ud83e\uddf3<\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u0627\u0644\u0628\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u062f\u062f\u0629<\/strong>: \u062a\u0642\u062f\u0645 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0645\u0648\u062b\u0648\u0642\u0629 \u0639\u0627\u062f\u0629 \u0628\u0627\u0642\u0627\u062a \u0645\u062a\u0646\u0648\u0639\u0629 (\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629\u060c \u0645\u062a\u0648\u0633\u0637\u0629\u060c VIP) \u062a\u0646\u0627\u0633\u0628 \u0645\u062e\u062a\u0644\u0641 \u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0627\u062a .<\/li>\n\n\n\n<li><strong>\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0634\u0627\u0645\u0644\u0629<\/strong>: \u062a\u0634\u0645\u0644 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629\u060c \u062a\u0630\u0627\u0643\u0631 \u0627\u0644\u0633\u0641\u0631\u060c \u0627\u0644\u0625\u0642\u0627\u0645\u0629 \u0641\u064a \u0641\u0646\u0627\u062f\u0642 \u0642\u0631\u064a\u0628\u0629 \u0645\u0646 \u0627\u0644\u062d\u0631\u0645\u060c \u0627\u0644\u0645\u0648\u0627\u0635\u0644\u0627\u062a\u060c \u0627\u0644\u0648\u062c\u0628\u0627\u062a\u060c \u0648\u0627\u0644\u0625\u0631\u0634\u0627\u062f \u0627\u0644\u062f\u064a\u0646\u064a .<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\">\u062c. <strong>\u0627\u0644\u062f\u0639\u0645 \u0648\u0627\u0644\u0645\u0631\u0634\u062f\u064a\u0646<\/strong> \ud83e\udd1d<\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u0648\u062c\u0648\u062f <strong>\u0645\u0631\u0634\u062f\u064a\u0646 \u062f\u064a\u0646\u064a\u064a\u0646<\/strong> \u0645\u062a\u062e\u0635\u0635\u064a\u0646 \u064a\u0631\u0627\u0641\u0642\u0648\u0646 \u0627\u0644\u0631\u062d\u0644\u0629 \u0644\u0634\u0631\u062d \u0627\u0644\u0645\u0646\u0627\u0633\u0643 \u0648\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u062f\u0639\u0645 \u0627\u0644\u0631\u0648\u062d\u0627\u0646\u064a \u0648\u0627\u0644\u0645\u0639\u0646\u0648\u064a \u0637\u0648\u0627\u0644 \u0627\u0644\u0631\u062d\u0644\u0629 .<\/li>\n\n\n\n<li><strong>\u0641\u0631\u064a\u0642 \u062f\u0639\u0645<\/strong> \u0639\u0644\u0649 \u0645\u062f\u0627\u0631 \u0627\u0644\u0633\u0627\u0639\u0629 \u0644\u0644\u0631\u062f \u0639\u0644\u0649 \u0627\u0633\u062a\u0641\u0633\u0627\u0631\u0627\u062a\u0643 \u0648\u062d\u0644 \u0623\u064a \u0645\u0634\u0643\u0644\u0629 \u062a\u0648\u0627\u062c\u0647\u0643 \u062e\u0644\u0627\u0644 \u0627\u0644\u0631\u062d\u0644\u0629.<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\">\u062f. <strong>\u0627\u0644\u0634\u0641\u0627\u0641\u064a\u0629 \u0648\u0627\u0644\u062a\u0643\u0627\u0644\u064a\u0641<\/strong> \ud83d\udcb0<\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u0648\u0636\u0648\u062d \u0627\u0644\u0623\u0633\u0639\u0627\u0631<\/strong> \u0648\u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u062a\u0643\u0627\u0644\u064a\u0641 \u062e\u0641\u064a\u0629. \u064a\u062c\u0628 \u0623\u0646 \u062a\u0648\u0636\u062d \u0627\u0644\u0634\u0631\u0643\u0629 \u0628\u0627\u0644\u062a\u0641\u0635\u064a\u0644 \u0645\u0627 \u0647\u0648 \u0645\u0634\u0645\u0648\u0644 \u0641\u064a \u0627\u0644\u0633\u0639\u0631 \u0648\u0645\u0627 \u0647\u0648 \u063a\u064a\u0631 \u0645\u0634\u0645\u0648\u0644 .<\/li>\n\n\n\n<li><strong>\u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0639\u0631\u0648\u0636<\/strong> \u0628\u064a\u0646 \u0639\u062f\u0629 \u0634\u0631\u0643\u0627\u062a \u0642\u0628\u0644 \u0627\u062a\u062e\u0627\u0630 \u0627\u0644\u0642\u0631\u0627\u0631 \u0627\u0644\u0646\u0647\u0627\u0626\u064a.<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\">2. \u0623\u0646\u0648\u0627\u0639 \u0628\u0627\u0642\u0627\u062a \u0648\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0639\u0645\u0631\u0629<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u062a\u062e\u062a\u0644\u0641 \u0627\u0644\u0628\u0627\u0642\u0627\u062a \u062d\u0633\u0628 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062e\u062f\u0645\u0629 \u0648\u0627\u0644\u0633\u0639\u0631\u060c \u0648\u0623\u0647\u0645\u0647\u0627:<\/p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th>\u0646\u0648\u0639 \u0627\u0644\u0628\u0627\u0642\u0629<\/th><th>\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0634\u0645\u0648\u0644\u0629<\/th><th>\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u062a\u0642\u0631\u064a\u0628\u064a (\u0642\u062f \u064a\u062e\u062a\u0644\u0641)<\/th><\/tr><\/thead><tbody><tr><td><strong>\u0628\u0627\u0642\u0629 \u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629<\/strong><\/td><td>\u0625\u0642\u0627\u0645\u0629 \u0641\u064a \u0641\u0646\u0627\u062f\u0642 3 \u0646\u062c\u0648\u0645\u060c \u0645\u0648\u0627\u0635\u0644\u0627\u062a \u062c\u0645\u0627\u0639\u064a\u0629\u060c \u0648\u062c\u0628\u0627\u062a \u0623\u0633\u0627\u0633\u064a\u0629<\/td><td>\u062a\u0628\u062f\u0623 \u0645\u0646 110-150 \u0631\u064a\u0627\u0644\/\u0627\u0644\u064a\u0648\u0645<\/td><\/tr><tr><td><strong>\u0628\u0627\u0642\u0629 \u0645\u062a\u0648\u0633\u0637\u0629<\/strong><\/td><td>\u0625\u0642\u0627\u0645\u0629 \u0641\u064a \u0641\u0646\u0627\u062f\u0642 4 \u0646\u062c\u0648\u0645\u060c \u0645\u0648\u0627\u0635\u0644\u0627\u062a \u0645\u0631\u064a\u062d\u0629\u060c \u0648\u062c\u0628\u0627\u062a \u0645\u062a\u0643\u0627\u0645\u0644\u0629<\/td><td>\u062a\u0628\u062f\u0623 \u0645\u0646 200-300 \u0631\u064a\u0627\u0644\/\u0627\u0644\u064a\u0648\u0645<\/td><\/tr><tr><td><strong>\u0628\u0627\u0642\u0629 VIP \u0641\u0627\u062e\u0631\u0629<\/strong><\/td><td>\u0625\u0642\u0627\u0645\u0629 \u0641\u064a \u0641\u0646\u0627\u062f\u0642 5 \u0646\u062c\u0648\u0645 \u0641\u0627\u062e\u0631\u0629\u060c \u0645\u0648\u0627\u0635\u0644\u0627\u062a \u062e\u0627\u0635\u0629\u060c \u0645\u0631\u0634\u062f \u0634\u062e\u0635\u064a\u060c \u0648\u062c\u0628\u0627\u062a \u0641\u0627\u062e\u0631\u0629<\/td><td>\u062a\u0628\u062f\u0623 \u0645\u0646 400 \u0631\u064a\u0627\u0644\/\u0627\u0644\u064a\u0648\u0645 \u0641\u0645\u0627 \u0641\u0648\u0642<\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\"><em>\u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u062a\u0642\u0631\u064a\u0628\u064a\u0629 \u0648\u0642\u062f \u062a\u062e\u062a\u0644\u0641 \u062d\u0633\u0628 \u0627\u0644\u0645\u0648\u0633\u0645 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u064a\u0629 .<\/em><\/p>\n\n\n\n<h2 class=\"wp-block-heading\">3. \u0623\u0628\u0631\u0632 \u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0639\u0645\u0631\u0629 \u0648\u0627\u0644\u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0645\u0648\u062b\u0648\u0642\u0629<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0648\u0627\u0644\u0633\u0645\u0639\u0629\u060c \u0625\u0644\u064a\u0643 \u0628\u0639\u0636 \u0623\u0628\u0631\u0632 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0641\u064a \u0627\u0644\u0633\u0648\u0642:<\/p>\n\n\n\n<ol class=\"wp-block-list\">\n<li><strong>\u0634\u0631\u0643\u0629 \u0643\u0646\u0632\u064a \u0644\u0644\u0633\u064a\u0627\u062d\u0629<\/strong>: \u062a\u064f\u0639\u062f \u0645\u0646 \u0623\u0641\u0636\u0644 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0641\u064a \u0645\u0635\u0631\u060c \u0648\u062a\u062a\u0645\u064a\u0632 \u0628\u062a\u0642\u062f\u064a\u0645 \u0645\u062d\u0627\u0636\u0631\u0627\u062a \u062f\u064a\u0646\u064a\u0629\u060c \u0625\u0634\u0631\u0627\u0641 \u0645\u0631\u0627\u0641\u0642\u060c \u0648\u062e\u064a\u0627\u0631\u0627\u062a \u0625\u0642\u0627\u0645\u0629 \u0641\u0627\u062e\u0631\u0629 .<\/li>\n\n\n\n<li><strong>\u062d\u0645\u0644\u0629 \u0627\u0644\u0627\u0633\u062a\u0642\u0627\u0645\u0629 \u0644\u0644\u062d\u062c \u0648\u0627\u0644\u0639\u0645\u0631\u0629<\/strong>: \u062a\u062d\u0638\u0649 \u0628\u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0639\u0627\u0644\u064a\u0629 \u062c\u062f\u064b\u0627 \u0645\u0646 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0644\u062a\u0646\u0638\u064a\u0645\u0647\u0627 \u0627\u0644\u0645\u062a\u0645\u064a\u0632 \u0648\u062c\u0648\u062f\u0629 \u062e\u062f\u0645\u0627\u062a\u0647\u0627 .<\/li>\n\n\n\n<li><strong>\u0634\u0631\u0643\u0629 \u0645\u0634\u0627\u0639\u0631 \u0644\u0644\u062d\u062c \u0648\u0627\u0644\u0639\u0645\u0631\u0629<\/strong>: \u0630\u064f\u0643\u0631\u062a \u0641\u064a \u0634\u0647\u0627\u062f\u0627\u062a \u0639\u0645\u0644\u0627\u0621 \u0623\u0634\u0627\u062f\u0648\u0627 \u0628\u0623\u062e\u0644\u0627\u0642 \u0637\u0627\u0642\u0645\u0647\u0627 \u0648\u0627\u062d\u062a\u0631\u0627\u0641\u064a\u062a\u0647\u0627 \u0641\u064a \u0627\u0644\u0639\u0645\u0644 .<\/li>\n\n\n\n<li><strong>\u0634\u0631\u0643\u0627\u062a \u0623\u062e\u0631\u0649 \u0645\u0631\u062e\u0635\u0629<\/strong>: \u064a\u064f\u0646\u0635\u062d \u0628\u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0645\u0631\u062e\u0635\u0629 \u0645\u062d\u0644\u064a\u064b\u0627 \u0641\u064a \u0628\u0644\u062f\u0643 \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0633\u0645\u0639\u062a\u0647\u0627 \u0639\u0628\u0631 \u0645\u0646\u0635\u0627\u062a \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u0648\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u0642\u064a\u064a\u0645.<\/li>\n<\/ol>\n\n\n\n<h2 class=\"wp-block-heading\">4. \u0646\u0635\u0627\u0626\u062d \u0642\u0628\u0644 \u0627\u0644\u062d\u062c\u0632 \u0648\u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0631\u062d\u0644\u0629<\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u0627\u062d\u0630\u0631 \u0645\u0646 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0645\u0631\u062e\u0635\u0629<\/strong>: \u0627\u0644\u062a\u064a \u062a\u0642\u062f\u0645 \u0639\u0631\u0648\u0636\u064b\u0627 \u0628\u0623\u0633\u0639\u0627\u0631 &#8220;too good to be true&#8221; (\u062c\u064a\u062f\u0629 \u062c\u062f\u064b\u0627 \u0644\u062f\u0631\u062c\u0629 \u064a\u0635\u0639\u0628 \u062a\u0635\u062f\u064a\u0642\u0647\u0627)\u060c \u0641\u0642\u062f \u062a\u0643\u0648\u0646 \u0627\u062d\u062a\u064a\u0627\u0644\u064a\u0629 .<\/li>\n\n\n\n<li><strong>\u0627\u0642\u0631\u0623 \u0627\u0644\u0639\u0642\u062f \u0628\u0639\u0646\u0627\u064a\u0629<\/strong>: \u0642\u0628\u0644 \u0627\u0644\u062a\u0648\u0642\u064a\u0639\u060c \u062a\u0623\u0643\u062f \u0645\u0646 \u0641\u0647\u0645 \u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u0646\u0648\u062f\u060c especially regarding cancellation and refund policies.<\/li>\n\n\n\n<li><strong>\u062c\u0647\u0632 \u0645\u0633\u062a\u0644\u0632\u0645\u0627\u062a\u0643<\/strong>: \u0627\u0644\u0648\u062b\u0627\u0626\u0642 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 (\u062c\u0648\u0627\u0632 \u0633\u0641\u0631\u060c \u062a\u0623\u0634\u064a\u0631\u0629)\u060c \u0645\u0644\u0627\u0628\u0633 \u0627\u0644\u0625\u062d\u0631\u0627\u0645\u060c \u0623\u062f\u0648\u064a\u0629 \u0634\u062e\u0635\u064a\u0629\u060c \u0648\u0645\u0635\u0631\u0648\u0641 \u0644\u0644\u0637\u0648\u0627\u0631\u0626.<\/li>\n\n\n\n<li><strong>\u062a\u0639\u0644\u0645 \u0627\u0644\u0645\u0646\u0627\u0633\u0643<\/strong>:\u5373\u4f7f \u0643\u0627\u0646\u062a \u0647\u0630\u0647 \u0647\u064a \u0639\u0645\u0631\u062a\u0643 \u0627\u0644\u0623\u0648\u0644\u0649\u060c \u062d\u0627\u0648\u0644 \u062a\u0639\u0644\u0645 \u062e\u0637\u0648\u0627\u062a \u0627\u0644\u0639\u0645\u0631\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 \u0645\u0633\u0628\u0642\u064b\u0627 \u0644\u062a\u0624\u062f\u064a\u0647\u0627 \u0628\u062b\u0642\u0629 .<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\">5. \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629<\/h2>\n\n\n\n<h3 class=\"wp-block-heading\">? \u0643\u064a\u0641 \u0623\u062a\u062d\u0642\u0642 \u0645\u0646 \u062a\u0631\u062e\u064a\u0635 \u0634\u0631\u0643\u0629 \u0627\u0644\u0639\u0645\u0631\u0629\u061f<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">\u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u062a\u0631\u062e\u064a\u0635 \u0627\u0644\u0634\u0631\u0643\u0629 \u0639\u0628\u0631 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0631\u0633\u0645\u064a \u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0623\u0648 \u0627\u0644\u0647\u064a\u0626\u0629 \u0627\u0644\u0645\u0646\u0638\u0645\u0629 \u0641\u064a \u0628\u0644\u062f\u0643. \u0641\u064a \u0645\u0635\u0631\u060c \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644\u060c \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062e\u062f\u0645\u0629 \u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u0632\u0627\u0631\u0629 \u0628\u0625\u062f\u062e\u0627\u0644 \u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 \u0623\u0648 \u0631\u0642\u0645 \u0627\u0644\u062a\u0631\u062e\u064a\u0635 .<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">? \u0645\u0627 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u0639\u0645\u0631\u0629 \u0648\u0627\u0644\u0632\u064a\u0627\u0631\u0629\u061f<\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u0627\u0644\u0639\u0645\u0631\u0629<\/strong>: \u0647\u064a \u0646\u0633\u0643 \u0645\u0633\u062a\u0642\u0644 \u0628\u0623\u0631\u0643\u0627\u0646 \u0645\u062d\u062f\u062f\u0629 (\u0627\u0644\u0625\u062d\u0631\u0627\u0645\u060c \u0627\u0644\u0637\u0648\u0627\u0641\u060c \u0627\u0644\u0633\u0639\u064a\u060c \u0627\u0644\u062d\u0644\u0642\/\u0627\u0644\u062a\u0642\u0635\u064a\u0631) \u0648\u064a\u0645\u0643\u0646 \u0623\u062f\u0627\u0624\u0647\u0627 \u0641\u064a \u0623\u064a \u0648\u0642\u062a \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 .<\/li>\n\n\n\n<li><strong>\u0627\u0644\u0632\u064a\u0627\u0631\u0629<\/strong>: \u063a\u0627\u0644\u0628\u064b\u0627 \u0645\u0627 \u064a\u0642\u0635\u062f \u0628\u0647\u0627 \u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0645\u0633\u062c\u062f \u0627\u0644\u0646\u0628\u0648\u064a \u0641\u064a \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060c \u0648\u0647\u064a \u0633\u0646\u0629 \u0645\u0633\u062a\u0642\u0644\u0629 \u0639\u0646 \u0627\u0644\u0639\u0645\u0631\u0629 \u0648\u0644\u064a\u0633\u062a \u0645\u0646 \u0623\u0631\u0643\u0627\u0646\u0647\u0627\u060c \u0648\u0644\u0643\u0646\u0647\u0627 \u0639\u0627\u062f\u0629 \u0645\u0627 \u062a\u0643\u0648\u0646 \u062c\u0632\u0621\u064b\u0627 \u0645\u0646 \u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0631\u062d\u0644\u0627\u062a .<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\">? \u0645\u0627\u0630\u0627 \u0623\u0641\u0639\u0644 \u0625\u0630\u0627 \u0648\u0627\u062c\u0647\u062a \u0645\u0634\u0643\u0644\u0629 \u0645\u0639 \u0627\u0644\u0634\u0631\u0643\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u0631\u062d\u0644\u0629\u061f<\/h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>\u062a\u0648\u0627\u0635\u0644 \u0623\u0648\u0644\u0627\u064b \u0645\u0639 \u0645\u0645\u062b\u0644 \u0627\u0644\u0634\u0631\u0643\u0629 \u0623\u0648 \u0642\u0627\u0626\u062f \u0627\u0644\u0631\u062d\u0644\u0629 \u0645\u0628\u0627\u0634\u0631\u0629 \u0644\u062d\u0644 \u0627\u0644\u0645\u0634\u0643\u0644\u0629.<\/li>\n\n\n\n<li>\u0625\u0630\u0627 \u0644\u0645 \u062a\u062d\u0644 \u0627\u0644\u0645\u0634\u0643\u0644\u0629\u060c \u0642\u0645 \u0628\u062a\u0648\u062b\u064a\u0642\u0647\u0627 (\u0635\u0648\u0631\u060c \u062a\u0642\u0627\u0631\u064a\u0631) \u0648\u062a\u0642\u062f\u064a\u0645 \u0634\u0643\u0648\u0649 \u0631\u0633\u0645\u064a\u0629 \u0644\u0644\u062c\u0647\u0629 \u0627\u0644\u0631\u0642\u0627\u0628\u064a\u0629 \u0627\u0644\u0645\u062e\u062a\u0635\u0629 \u0641\u064a \u0628\u0644\u062f\u0643 \u0628\u0639\u062f \u0627\u0644\u0639\u0648\u062f\u0629.<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\">6. \u0623\u0647\u0645\u064a\u0629 \u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0648\u0634\u0647\u0627\u062f\u0627\u062a \u0627\u0644\u0639\u0645\u0644\u0627\u0621<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u0644\u0627 \u062a\u0633\u062a\u0647\u064a\u0646 \u0628\u0642\u0648\u0629 <strong>\u0634\u0647\u0627\u062f\u0627\u062a \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u0633\u0627\u0628\u0642\u064a\u0646<\/strong>. \u0641\u0647\u064a \u0645\u0631\u0622\u0629 \u062a\u0639\u0643\u0633 \u0627\u0644\u0648\u0627\u0642\u0639 \u0627\u0644\u062d\u0642\u064a\u0642\u064a \u0644\u062c\u0648\u062f\u0629 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0642\u062f\u0645\u0647\u0627 \u0627\u0644\u0634\u0631\u0643\u0629\u060c \u0645\u0646 \u0627\u0644\u062a\u0646\u0638\u064a\u0645 \u0648\u0627\u0644\u0625\u0642\u0627\u0645\u0629 \u0625\u0644\u0649 \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0637\u0648\u0627\u0631\u0626. \u0627\u0628\u062d\u062b \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0635\u0627\u062a \u0627\u0644\u0645\u0648\u062b\u0648\u0642\u0629 \u0648\u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a .<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">\u062e\u0627\u062a\u0645\u0629<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">\u0627\u062e\u062a\u064a\u0627\u0631 <strong>\u0623\u0641\u0636\u0644 \u0634\u0631\u0643\u0629 \u0639\u0645\u0631\u0629 \u0648\u0632\u064a\u0627\u0631\u0629<\/strong> \u0647\u0648 \u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0641\u064a \u0631\u062d\u0644\u062a\u0643 \u0627\u0644\u0631\u0648\u062d\u0627\u0646\u064a\u0629 \u0648\u0636\u0645\u0627\u0646 \u0644\u062a\u0631\u0643\u064a\u0632\u0643 \u0627\u0644\u0643\u0627\u0645\u0644 \u0639\u0644\u0649 \u0627\u0644\u0639\u0628\u0627\u062f\u0629 \u0628\u0639\u064a\u062f\u064b\u0627 \u0639\u0646 \u0645\u062a\u0627\u0639\u0628 \u0627\u0644\u062a\u0631\u062a\u064a\u0628\u0627\u062a \u0627\u0644\u0644\u0648\u062c\u0633\u062a\u064a\u0629. \u0644\u0627 \u062a\u0643\u0646 \u0627\u0644\u0633\u0639\u0631 \u0647\u0648 \u0627\u0644\u0639\u0627\u0645\u0644 \u0627\u0644\u0648\u062d\u064a\u062f \u0644\u0627\u062a\u062e\u0627\u0630 \u0642\u0631\u0627\u0631\u0643\u060c \u0628\u0644 \u0627\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0633\u0645\u0639\u0629\u060c \u062c\u0648\u062f\u0629 \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u0648\u0627\u0644\u0634\u0641\u0627\u0641\u064a\u0629. \u062e\u0630 \u0648\u0642\u062a\u0643 \u0641\u064a \u0627\u0644\u0628\u062d\u062b\u060c \u0642\u0627\u0631\u0646 \u0628\u064a\u0646 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a\u060c \u0648\u0627\u062e\u062a\u0631 \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u062a\u064a \u062a\u0645\u0646\u062d\u0643 \u062b\u0642\u0629 \u0648\u0631\u0627\u062d\u0629 \u0628\u0627\u0644.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u0646\u0633\u0623\u0644 \u0627\u0644\u0644\u0647 \u0623\u0646 \u064a\u062a\u0642\u0628\u0644 \u0645\u0646\u0627 \u0648\u0645\u0646\u0643\u0645 \u0627\u0644\u0637\u0627\u0639\u0627\u062a\u060c \u0648\u0623\u0646 \u064a\u064a\u0633\u0631 \u0644\u0646\u0627 \u0648\u0644\u0643\u0645 \u0633\u0628\u064a\u0644 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0628\u064a\u062a\u0647 \u0627\u0644\u062d\u0631\u0627\u0645\u060c \u0648\u0623\u0646 \u064a\u0645\u0643\u0646 \u0644\u0646\u0627 \u0