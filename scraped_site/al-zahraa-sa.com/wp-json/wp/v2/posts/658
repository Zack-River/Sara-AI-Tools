. \u062a\u0644\u0639\u0628 \u0647\u0630\u0647 \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u062f\u0648\u0631\u0627\u064b \u0645\u062d\u0648\u0631\u064a\u0627\u064b \u0641\u064a \u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0633\u0643\u0646\u064a\u0629 \u0648\u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0648\u0641\u0642 \u0623\u0639\u0644\u0649 \u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u062c\u0648\u062f\u0629 \u0648\u0627\u0644\u0633\u0644\u0627\u0645\u0629.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>\u0644\u0645\u0627\u0630\u0627 \u062a\u0644\u062c\u0623 \u0625\u0644\u0649 \u0634\u0631\u0643\u0627\u062a \u0639\u0645\u0631\u0647\u061f<\/strong><\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u0627\u0644\u062e\u0628\u0631\u0629 \u0627\u0644\u0641\u0646\u064a\u0629:<\/strong>\u00a0\u062a\u0645\u062a\u0644\u0643\u00a0<strong>\u0623\u0641\u0636\u0644 \u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0639\u0645\u0631\u0629<\/strong>\u00a0\u0643\u0648\u0627\u062f\u0631 \u0647\u0646\u062f\u0633\u064a\u0629 \u0648\u0625\u0634\u0631\u0627\u0641\u064a\u0629 \u0645\u062a\u062e\u0635\u0635\u0629 \u062a\u0636\u0645\u0646 \u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0628\u062f\u0642\u0629 \u0641\u0627\u0626\u0642\u0629.<\/li>\n\n\n\n<li><strong>\u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u0648\u0642\u062a \u0648\u0627\u0644\u062c\u0647\u062f:<\/strong>\u00a0\u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639\u00a0<strong>\u0634\u0631\u0643\u0629 \u0639\u0645\u0631\u0629 \u0645\u062a\u062e\u0635\u0635\u0629<\/strong>\u00a0\u064a\u062d\u0631\u0631\u0643 \u0645\u0646 \u0645\u062a\u0627\u0639\u0628 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0648\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0639\u0645\u0627\u0644\u0629 \u0648\u0634\u0631\u0627\u0621 \u0627\u0644\u0645\u0648\u0627\u062f.<\/li>\n\n\n\n<li><strong>\u0636\u0645\u0627\u0646 \u0627\u0644\u062c\u0648\u062f\u0629:<\/strong>\u00a0\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0648\u0627\u062f \u0628\u0646\u0627\u0621 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062c\u0648\u062f\u0629 \u0648\u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u0627\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629 \u064a\u0636\u0645\u0646 \u0644\u0643 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649\u00a0<strong>\u0639\u0645\u0631\u0629 \u0645\u062a\u0642\u0646\u0629<\/strong>\u00a0\u062a\u062a\u062d\u0645\u0644 \u0639\u0648\u0627\u0645\u0644 \u0627\u0644\u0632\u0645\u0646.<\/li>\n\n\n\n<li><strong>\u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0627\u0644\u0645\u062f\u0631\u0648\u0633\u0629:<\/strong>\u00a0\u062a\u0642\u062f\u0645 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646\u00a0<strong>\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0639\u0645\u0631\u0629<\/strong>\u00a0\u0639\u0631\u0648\u0636\u0627\u064b \u0648\u062f\u0631\u0627\u0633\u0627\u062a \u062c\u062f\u0648\u0649 \u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 \u062a\u062d\u0642\u0642 \u0644\u0643 \u0627\u0644\u062a\u0648\u0641\u064a\u0631 \u062f\u0648\u0646 \u0627\u0644\u0645\u0633\u0627\u0633 \u0628\u0627\u0644\u062c\u0648\u062f\u0629.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>\u0643\u064a\u0641 \u062a\u062e\u062a\u0627\u0631 \u0623\u0641\u0636\u0644 \u0634\u0631\u0643\u0627\u062a \u0639\u0645\u0631\u0647\u061f<\/strong><\/p>\n\n\n\n<ol start=\"1\" class=\"wp-block-list\">\n<li><strong>\u0627\u0644\u0633\u0645\u0639\u0629 \u0648\u0627\u0644\u062e\u0628\u0631\u0629:<\/strong>\u00a0\u0627\u0628\u062d\u062b \u0639\u0646 \u0634\u0631\u0643\u0627\u062a \u0630\u0627\u062a \u062a\u0627\u0631\u064a\u062e \u062d\u0627\u0641\u0644 \u0641\u064a \u0645\u062c\u0627\u0644\u00a0<strong>\u0627\u0644\u0639\u0645\u0631\u0629 \u0648\u0627\u0644\u0628\u0646\u0627\u0621<\/strong>\u00a0\u0648\u0627\u0637\u0644\u0628 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 portfolio \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0633\u0627\u0628\u0642\u0629.<\/li>\n\n\n\n<li><strong>\u0627\u0644\u062a\u0631\u0627\u062e\u064a\u0635 \u0648\u0627\u0644\u062a\u0635\u0627\u0631\u064a\u062d:<\/strong>\u00a0\u062a\u0623\u0643\u062f \u0645\u0646 \u062d\u0635\u0648\u0644 \u0627\u0644\u0634\u0631\u0643\u0629 \u0639\u0644\u0649 \u0627\u0644\u062a\u0631\u0627\u062e\u064a\u0635 \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0645\u0646 \u0627\u0644\u062c\u0647\u0627\u062a \u0627\u0644\u0645\u062e\u062a\u0635\u0629 \u0645\u062b\u0644 \u0627\u0644\u0647\u064a\u0626\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0644\u0645\u0647\u0646\u062f\u0633\u064a\u0646.<\/li>\n\n\n\n<li><strong>\u0627\u0633\u062a\u0634\u0627\u0631\u0629 \u0645\u062c\u0627\u0646\u064a\u0629:<\/strong>\u00a0\u0643\u062b\u064a\u0631 \u0645\u0646\u00a0<strong>\u0645\u0643\u0627\u062a\u0628 \u0627\u0644\u0639\u0645\u0631\u0629<\/strong>\u00a0\u062a\u0642\u062f\u0645 \u0627\u0633\u062a\u0634\u0627\u0631\u0627\u062a \u0645\u062c\u0627\u0646\u064a\u0629 \u0623\u0648\u0644\u064a\u0629\u060c \u0627\u0633\u062a\u0641\u062f \u0645\u0646\u0647\u0627 \u0644\u062a\u0642\u064a\u064a\u0645 \u0645\u062f\u0649 \u0627\u062d\u062a\u0631\u0627\u0641\u064a\u062a\u0647\u0645 \u0648\u0641\u0647\u0645\u0647\u0645 \u0644\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a\u0643.<\/li>\n\n\n\n<li><strong>\u0627\u0644\u0639\u0642\u0648\u062f \u0627\u0644\u0648\u0627\u0636\u062d\u0629:<\/strong>\u00a0\u0627\u062e\u062a\u0627\u0631\u00a0<strong>\u0634\u0631\u0643\u0627\u062a \u0639\u0645\u0631\u0647<\/strong>\u00a0\u062a\u0642\u062f\u0645 \u0639\u0642\u0648\u062f\u0627\u064b \u0645\u0641\u0635\u0644\u0629 \u062a\u0634\u0645\u0644 \u062c\u0645\u064a\u0639 \u0628\u0646\u0648\u062f \u0627\u0644\u0639\u0645\u0644\u060c \u0648\u0627\u0644\u062a\u0643\u0627\u0644\u064a\u0641\u060c \u0648\u0645\u062f\u062f \u0627\u0644\u062a\u0646\u0641\u