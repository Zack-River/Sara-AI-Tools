2c\u0648\u062f \u062f\u0627\u062e\u0644 \u0627\u0644\u062d\u0631\u0645<\/li>\r\n          <li style=\"margin-bottom:6px\">\u23f0 \u0641\u064a \u0627\u0644\u062b\u0644\u062b \u0627\u0644\u0623\u062e\u064a\u0631 \u0645\u0646 \u0627\u0644\u0644\u064a\u0644<\/li>\r\n        <\/ul>\r\n      <\/div>\r\n      <div style=\"background:rgba(197,173,124,0.05); padding:18px; border-radius:20px; margin:20px 0\">\r\n        <h4 style=\"color:#FFD700; margin:0 0 12px 0\">\ud83d\udcff \u0623\u062f\u0639\u064a\u0629 \u0645\u0633\u062a\u062d\u0628\u0629:<\/h4>\r\n        <p style=\"margin-bottom:8px\"><strong>\u062f\u0639\u0627\u0621 \u0627\u0644\u0637\u0648\u0627\u0641:<\/strong> \"\u0631\u064e\u0628\u064e\u0651\u0646\u064e\u0627 \u0622\u062a\u0650\u0646\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u062f\u064f\u0651\u0646\u0652\u064a\u064e\u0627 \u062d\u064e\u0633\u064e\u0646\u064e\u0629\u064b \u0648\u064e\u0641\u0650\u064a \u0627\u0644\u0652\u0622\u062e\u0650\u0631\u064e\u0629\u0650 \u062d\u064e\u0633\u064e\u0646\u064e\u0629\u064b \u0648\u064e\u0642\u0650\u0646\u064e\u0627 \u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650\"<\/p>\r\n        <p><strong>\u062f\u0639\u0627\u0621 \u0628\u064a\u0646 \u0627\u0644\u0631\u0643\u0646 \u0627\u0644\u064a\u0645\u0627\u0646\u064a \u0648\u0627\u0644\u062d\u062c\u0631 \u0627\u0644\u0623\u0633\u0648\u062f:<\/strong> \"\u0631\u064e\u0628\u064e\u0651\u0646\u064e\u0627 \u0622\u062a\u0650\u0646\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u062f\u064f\u0651\u0646\u0652\u064a\u064e\u0627 \u062d\u064e\u0633\u064e\u0646\u064e\u0629\u064b \u0648\u064e\u0641\u0650\u064a \u0627\u0644\u0652\u0622\u062e\u0650\u0631\u064e\u0629\u0650 \u062d\u064e\u0633\u064e\u0646\u064e\u0629\u064b \u0648\u064e\u0642\u0650\u0646\u064e\u0627 \u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650\"<\/p>\r\n      <\/div>\r\n      <p>\u0627\u062c\u0639\u0644 \u0644\u062f\u0639\u0627\u0626\u0643 \u062d\u0636\u0648\u0631\u0627\u064b \u0641\u064a \u0642\u0644\u0628\u0643\u060c \u0648\u062a\u064a\u0642\u0646 \u0628\u0627\u0644\u0625\u062c\u0627\u0628\u0629\u060c \u0641\u0625\u0646 \u0627\u0644\u0644\u0647 \u0644\u0627 \u064a\u0631\u062f \u0645\u0646 \u062f\u0639\u0627\u0647 \u0628\u0635\u062f\u0642.<\/p>\r\n    `\r\n  }\r\n};\r\n\r\n\/\/ ============================================\r\n\/\/ \u0646\u0638\u0627\u0645 \u0627\u0644\u0628\u0648\u0628 \u0623\u0628 \u0627\u0644\u0645\u0637\u0648\u0631\r\n\/\/ ============================================\r\nconst modal = document.getElementById('article-modal');\r\nconst modalImg = document.getElementById('modal-img');\r\nconst modalTitle = document.getElementById('modal-title');\r\nconst modalDate = document.getElementById('modal-date');\r\nconst modalReadTime = document.getElementById('modal-readtime');\r\nconst modalContent = document.getElementById('modal-content');\r\nconst closeBtn = document.getElementById('close-modal');\r\n\r\n\/\/ \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0623\u064a \u0628\u0637\u0627\u0642\u0629 \u0623\u0648 \u0632\u0631\r\ndocument.querySelectorAll('.blog-card').forEach(card => {\r\n  const readMoreBtn = card.querySelector('.read-more-btn');\r\n  const cardElement = card;\r\n  \r\n  const openModal = (e) => {\r\n    e.stopPropagation();\r\n    const articleId = cardElement.getAttribute('data-article-id');\r\n    const article = articlesData[articleId];\r\n    \r\n    if(article) {\r\n      modalTitle.textContent = article.title;\r\n      modalDate.textContent = `\ud83d\udcc5 ${article.date}`;\r\n      modalReadTime.textContent = `\u2b50 ${article.readTime}`;\r\n      modalImg.src = article.img;\r\n      modalContent.innerHTML = article.content;\r\n      modal.style.display = 'flex';\r\n      document.body.style.overflow = 'hidden';\r\n    }\r\n  };\r\n  \r\n  readMoreBtn.addEventListener('click', openModal);\r\n  cardElement.addEventListener('click', openModal);\r\n});\r\n\r\n\/\/ \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0628\u0648\u0628 \u0623\u0628\r\ncloseBtn.addEventListener('click', () => {\r\n  modal.style.display = 'none';\r\n  document.body.style.overflow = 'auto';\r\n});\r\n\r\n\/\/ \u0625\u063a\u0644\u0627\u0642 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u062d\u062a\u0648\u0649\r\nmodal.addEventListener('click', (e) => {\r\n  if(e.target === modal) {\r\n    modal.style.display = 'none';\r\n    document.body.style.overflow = 'auto';\r\n  }\r\n});\r\n\r\n\/\/ \u0625\u063a\u0644\u0627\u0642 \u0628\u0636\u063a\u0637 ESC\r\ndocument.addEventListener('keydown', (e) => {\r\n  if(e.key === 'Escape' && modal.style.display === 'flex') {\r\n    modal.style.display = 'none';\r\n    document.body.style.overflow = 'auto';\r\n  }\r\n});\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-74060a9 elementor-section-full_width elementor-section-stretched elementor-section-height-default elementor-section-height-default\" data-id=\"74060a9\" data-element_type=\"section\" data-settings=\"{&quot;stretch_section&quot;:&quot;section-stretched&quot;,&quot;_ha_eqh_enable&quot;:false}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-70080af\" data-id=\"70080af\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-151cf04 elementor-widget elementor-widget-html\" data-id=\"151cf04\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!-- \u0641\u0648\u0631\u0645 \u062a\u0648\u0627\u0635\u0644 \u0627\u062d\u