n-bottom:15px\">\u0634\u0647\u0631 \u0631\u0645\u0636\u0627\u0646 \u0627\u0644\u0645\u0628\u0627\u0631\u0643 \u0647\u0648 \u0634\u0647\u0631 \u0627\u0644\u0631\u062d\u0645\u0629 \u0648\u0627\u0644\u0645\u063a\u0641\u0631\u0629\u060c \u0648\u0641\u064a\u0647 \u062a\u062a\u0636\u0627\u0639\u0641 \u0627\u0644\u062d\u0633\u0646\u0627\u062a \u0648\u062a\u064f\u0641\u062a\u062d \u0623\u0628\u0648\u0627\u0628 \u0627\u0644\u062c\u0646\u0629. \u0648\u062a\u0639\u062a\u0628\u0631 \u0627\u0644\u0639\u0645\u0631\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0641\u0636\u064a\u0644 \u0645\u0646 \u0623\u0639\u0638\u0645 \u0627\u0644\u0642\u0631\u0628\u0627\u062a \u0625\u0644\u0649 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649.<\/p>\r\n      <div style=\"background:rgba(197,173,124,0.08); padding:18px; border-radius:20px; margin:20px 0\">\r\n        <h4 style=\"color:#FFD700; margin:0 0 12px 0\">\ud83c\udf38 \u0623\u0641\u0636\u0644 \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0641\u064a \u0639\u0645\u0631\u0629 \u0631\u0645\u0636\u0627\u0646:<\/h4>\r\n        <ul style=\"margin-right:20px; margin-bottom:0\">\r\n          <li style=\"margin-bottom:8px\">\ud83d\udcff \u0627\u0644\u0625\u0643\u062b\u0627\u0631 \u0645\u0646 \u0627\u0644\u062a\u0644\u0628\u064a\u0629 \u0648\u0627\u0644\u062f\u0639\u0627\u0621 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0637\u0648\u0627\u0641 \u0648\u0627\u0644\u0633\u0639\u064a<\/li>\r\n          <li style=\"margin-bottom:8px\">\ud83e\udd32 \u0627\u0644\u062f\u0639\u0627\u0621 \u0639\u0646\u062f \u0627\u0644\u0645\u0644\u062a\u0632\u0645 \u0648\u0634\u0631\u0628 \u0645\u0627\u0621 \u0632\u0645\u0632\u0645 \u0628\u0646\u064a\u0629 \u0635\u0627\u062f\u0642\u0629<\/li>\r\n          <li style=\"margin-bottom:8px\">\ud83d\udcd6 \u062e\u062a\u0645 \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0641\u064a \u0627\u0644\u062d\u0631\u0645\u064a\u0646 \u0627\u0644\u0634\u0631\u064a\u0641\u064a\u0646<\/li>\r\n          <li style=\"margin-bottom:8px\">\ud83c\udf19 \u0642\u064a\u0627\u0645 \u0627\u0644\u0644\u064a\u0644 \u0648\u0627\u0644\u0635\u0644\u0627\u0629 \u0641\u064a \u0627\u0644\u0631\u0648\u0636\u0629 \u0627\u0644\u0634\u0631\u064a\u0641\u0629<\/li>\r\n        <\/ul>\r\n      <\/div>\r\n      <p>\u0646\u0633\u0623\u0644 \u0627\u0644\u0644\u0647 \u0623\u0646 \u064a\u062a\u0642\u0628\u0644 \u0645\u0646\u0627 \u0648\u0645\u0646\u0643\u0645 \u0635\u0627\u0644\u062d \u0627\u0644\u0623\u0639\u0645\u0627\u0644\u060c \u0648\u0623\u0646 \u064a\u0628\u0644\u063a\u0646\u0627 \u0648\u0625\u064a\u0627\u0643\u0645 \u0639\u0645\u0631\u0629 \u0645\u0642\u0628\u0648\u0644\u0629 \u0641\u064a \u0631\u0645\u0636\u0627\u0646.<\/p>\r\n    `\r\n  },\r\n  2: {\r\n    title: \"10 \u0646\u0635\u0627\u0626\u062d \u0630\u0647\u0628\u064a\u0629 \u0644\u0631\u062d\u0644\u0629 \u0639\u0645\u0631\u0629 \u0645\u064a\u0633\u0631\u0629\",\r\n    date: \"10 \u0645\u0627\u0631\u0633 2025\",\r\n    readTime: \"4 \u062f\u0642\u0627\u0626\u0642 \u0642\u0631\u0627\u0621\u0629\",\r\n    img: \"https:\/\/al-zahraa-sa.com\/wp-content\/uploads\/2024\/09\/348008867.jpg\",\r\n    content: `\r\n      <p style=\"margin-bottom:15px\">\u2728 \u0631\u062d\u0644\u0629 \u0627\u0644\u0639\u0645\u0631\u0629 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u062a\u062d\u0636\u064a\u0631 \u062c\u064a\u062f \u0644\u062a\u0643\u0648\u0646 \u0645\u0631\u064a\u062d\u0629 \u0648\u0631\u0648\u062d\u0627\u0646\u064a\u0629. \u0625\u0644\u064a\u0643 \u0623\u0647\u0645 \u0627\u0644\u0646\u0635\u0627\u0626\u062d \u0627\u0644\u062a\u064a \u062a\u062c\u0639\u0644 \u062a\u062c\u0631\u0628\u062a\u0643 \u0644\u0627 \u062a\u064f\u0646\u0633\u0649:<\/p>\r\n      <div style=\"background:rgba(197,173,124,0.08); padding:18px; border-radius:20px; margin:20px 0\">\r\n        <h4 style=\"color:#FFD700; margin:0 0 12px 0\">\ud83d\udccc \u0646\u0635\u0627\u0626\u062d \u0630\u0647\u0628\u064a\u0629:<\/h4>\r\n        <ol style=\"margin-right:20px; margin-bottom:0\">\r\n          <li style=\"margin-bottom:6px\"><strong>\u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0645\u0633\u0628\u0642:<\/strong> \u0627\u062d\u062c\u0632 \u0631\u062d\u0644\u062a\u0643 \u0642\u0628\u0644 \u0645\u0648\u0639\u062f \u0627\u0644\u0633\u0641\u0631 \u0628\u0648\u0642\u062a \u0643\u0627\u0641\u064d<\/li>\r\n          <li style=\"margin-bottom:6px\"><strong>\u062a\u0639\u0644\u0645 \u0627\u0644\u0645\u0646\u0627\u0633\u0643:<\/strong> \u0627\u062d\u0631\u0635 \u0639\u0644\u0649 \u0645\u0639\u0631\u0641\u0629 \u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0639\u0645\u0631\u0629 \u0648\u0623\u062f\u0639\u064a\u0629 \u0627\u0644\u0637\u0648\u0627\u0641 \u0648\u0627\u0644\u0633\u0639\u064a<\/li>\r\n          <li style=\"margin-bottom:6px\"><strong>\u062d\u0642\u064a\u0628\u0629 \u0645\u062a\u0643\u0627\u0645\u0644\u0629:<\/strong> \u0627\u062d\u0636\u0631 \u0645\u0639\u0643 \u0627\u0644\u0625\u062d\u0631\u0627\u0645 \u0648\u0627\u0644\u0623\u062f\u0648\u064a\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629<\/li>\r\n          <li style=\"margin-bottom:6px\"><strong>\u0627\u062e\u062a\u064a\u0627\u0631 \u0641\u0646\u062f\u0642 \u0642\u0631\u064a\u0628:<\/strong> \u064a\u0633\u0647\u0644 \u0639\u0644\u064a\u0643 \u0627\u0644\u0630\u0647\u0627\u0628 \u0625\u0644\u0649 \u0627\u0644\u062d\u0631\u0645 \u0641\u064a \u0623\u064a \u0648\u0642\u062a<\/li>\r\n          <li style=\"margin-bottom:6px\"><strong>\u062a\u0646\u0638\u064a\u0645 \u0627\u0644\u0648\u0642\u062a:<\/strong> \u0648\u0632\u0639 \u0639\u0628\u0627\u062f\u0627\u062a\u0643 \u0628\u064a\u0646 \u0627\u0644\u0637\u0648\u0627\u0641 \u0648\u0627\u0644\u0635\u0644\u0627\u0629 \u0648\u0627\u0644\u062f\u0639\u0627\u0621<\/li>\r\n        <\/ol>\r\n      <\/div>\r\n      <p>\u0646\u062a\u0645\u0646\u0649 \u0644\u0643 \u0631\u062d\u0644\u0629 \u0631\u0648\u062d\u0627\u0646\u064a\u0629 \u0645\u0628\u0627\u0631\u0643\u0629 \u0645\u0644\u064a\u0626\u0629 \u0628\u0