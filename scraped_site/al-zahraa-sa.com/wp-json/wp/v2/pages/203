der:none; padding:12px 30px; border-radius:50px; font-size:0.9rem; font-weight:700; cursor:pointer\">\u062d\u0633\u0646\u0627\u064b<\/button>\r\n  <\/div>\r\n<\/div>\r\n\r\n<style>\r\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Cairo:wght@400;500;600;700;800&display=swap');\r\n  \r\n  \/* \u0623\u0646\u064a\u0645\u064a\u0634\u0646 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 *\/\r\n  @keyframes formBg1 {\r\n    0%,100% { transform: translate(0,0) scale(1); }\r\n    50% { transform: translate(40px, -30px) scale(1.08); }\r\n  }\r\n  @keyframes formBg2 {\r\n    0%,100% { transform: translate(0,0) scale(1); }\r\n    50% { transform: translate(-35px, 35px) scale(1.1); }\r\n  }\r\n  @keyframes formBg3 {\r\n    0%,100% { transform: translate(0,0) scale(1); }\r\n    50% { transform: translate(30px, 25px) scale(1.12); }\r\n  }\r\n  @keyframes formStar1 {\r\n    0% { transform: translate(0,0); opacity:0.6; }\r\n    50% { transform: translate(-20px, -15px); opacity:0.1; }\r\n    100% { transform: translate(0,0); opacity:0.6; }\r\n  }\r\n  @keyframes formStar2 {\r\n    0% { transform: translate(0,0); opacity:0.5; }\r\n    50% { transform: translate(18px, -12px); opacity:0.1; }\r\n    100% { transform: translate(0,0); opacity:0.5; }\r\n  }\r\n  @keyframes formStar3 {\r\n    0% { transform: translate(0,0); opacity:0.7; }\r\n    50% { transform: translate(-15px, 18px); opacity:0.15; }\r\n    100% { transform: translate(0,0); opacity:0.7; }\r\n  }\r\n  @keyframes formSlideRight {\r\n    0% { opacity:0; transform:translateX(-50px); }\r\n    100% { opacity:1; transform:translateX(0); }\r\n  }\r\n  @keyframes formSlideLeft {\r\n    0% { opacity:0; transform:translateX(50px); }\r\n    100% { opacity:1; transform:translateX(0); }\r\n  }\r\n  @keyframes modalFadeIn {\r\n    0% { opacity:0; transform:scale(0.9); }\r\n    100% { opacity:1; transform:scale(1); }\r\n  }\r\n  \r\n  \/* \u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0625\u062f\u062e\u0627\u0644 *\/\r\n  input:focus, select:focus, textarea:focus {\r\n    border-color: #C5AD7C !important;\r\n    box-shadow: 0 0 0 3px rgba(197,173,124,0.1);\r\n  }\r\n  \r\n  button:hover {\r\n    transform: translateY(-3px);\r\n    box-shadow: 0 12px 25px -8px rgba(197,173,124,0.4);\r\n  }\r\n  \r\n  \/* \u0627\u0633\u062a\u062c\u0627\u0628\u0629 *\/\r\n  @media (max-width: 968px) {\r\n    #contact-form-pro [style*=\"grid-template-columns:1fr 1fr\"] {\r\n      grid-template-columns: 1fr !important;\r\n      gap: 40px !important;\r\n    }\r\n    #contact-form-pro h2 {\r\n      font-size: 2rem !important;\r\n    }\r\n  }\r\n  \r\n  @media (max-width: 568px) {\r\n    #contact-form-pro {\r\n      padding: 50px 0 !important;\r\n    }\r\n    #contact-form-pro [style*=\"padding:40px 35px\"] {\r\n      padding: 30px 20px !important;\r\n    }\r\n  }\r\n<\/style>\r\n\r\n<script>\r\n\/\/ ============================================\r\n\/\/ \u0645\u0639\u0627\u0644\u062c\u0629 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0641\u0648\u0631\u0645\r\n\/\/ ============================================\r\nconst contactForm = document.getElementById('contactForm');\r\nconst successPopup = document.getElementById('successPopup');\r\nconst closeSuccess = document.getElementById('closeSuccess');\r\n\r\n\/\/ \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u0644\u0644\u0648\u0627\u062a\u0633 \u0622\u0628\r\nconst whatsappNumber1 = '966562685953'; \/\/ 0562685953\r\nconst whatsappNumber2 = '966544591931'; \/\/ 544591931\r\n\r\ncontactForm.addEventListener('submit', function(e) {\r\n  e.preventDefault();\r\n  \r\n  \/\/ \u062c\u0644\u0628 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\r\n  const name = document.getElementById('userName').value.trim();\r\n  const phone = document.getElementById('userPhone').value.trim();\r\n  const email = document.getElementById('userEmail').value.trim();\r\n  const service = document.getElementById('serviceType').value;\r\n  const message = document.getElementById('userMessage').value.trim();\r\n  \r\n  \/\/ \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062d\u0642\u0648\u0644\r\n  if(!name || !phone || !email || !service || !message) {\r\n    alert('\u274c \u0627\u0644\u0631\u062c\u0627\u0621 \u062a\u0639\u0628\u0626\u0629 \u062c\u0645\u064a\u0639 \u0627\u0644\u062d\u0642\u0648\u0644');\r\n    return;\r\n  }\r\n  \r\n  \/\/ \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0625\u064a\u0645\u064a\u0644\r\n  const emailPattern = \/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$\/;\r\n  if(!emailPattern.test(email)) {\r\n    alert('\u274c \u0627\u0644\u0631\u062c\u0627\u0621 \u0625\u062f\u062e\u0627\u0644 \u0628\u0631\u064a\u062f \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0635\u062d\u064a\u062d');\r\n    return;\r\n  }\r\n  \r\n  \/\/ \u0632\u0631 \u0627\u0644\u0625\u0631\u0633\u0627\u0644 - \u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u062d\u0645\u064a\u0644\r\n  const submitBtn = document.getElementById('submitBtn');\r\n  const originalText = submitBtn.innerHTML;\r\n  submitBtn.innerHTML = '\u231b \u062c\u0627\u0631\u064a \u0627\u0644\u0625\u0631\u0633\u0627\u0644...';\r\n  submitBtn.disabled = true;\r\n  \r\n  \/\/ \u0628\u0646\u0627\u0621 \u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0648\u0627\u062a\u0633 \u0622\u0628\r\n  const whatsappMessage = `*\ud83d\udd4b \u0634\u0631\u0643\u0629 \u0627\u0644\u0632\u0647\u0631\u0627\u0621 \u0644\u0644\u0639\u0645\u0631\u0629 \u0648\u0627\u0644\u0632\u064a\u0627\u0631\u0629*%0A%0A*\ud83d\udccb \u0637\u0644\u0628 \u062a\u0648\u0627\u0635\u0644 \u062c\u062f\u064a\u062f*%0A%0A*\ud83d\udc64 \u0627\u0644\u0627\u0633\u0645:* ${name}%0A*\ud83d\udcf1 \u0627\u0644\u062c\u0648\u0627\u0644:* ${phone}%0A*\u2709\ufe0f \u0627\u0644\u0628\u0631\u064a\u062f:* ${email}%0A*\ud83c\udfe8 \u0627\u0644\u062e\u062f\u0645\u0629:* ${service}%0A*\ud83d\udcac \u0627\u0644\u0631\u0633\u0627\u0644\u0629:* ${message}%0A%0A\ud83d\udcc5 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0631\u0633\u0627\u0644: ${new Date().toLocaleString('ar-EG')}`;\r\n  \r\n  \/\/ \u0627\u0644\u0631\u0627\u0628\u0637 \u0639\u0644\u0649 \u0623\u0648\u0644 \u0631\u0642\u0645 \u0648\u0627\u062a\u0633 \u0622\u0628\r\n  const whatsappUrl = `https:\/\/wa.me\/${whatsappNumber1}?text=${whatsappMessage}`;\r\n  \r\n  \/\/ \u0645\u062d\u0627\u0643\u0627\u0629 \u0625\u0631\u0633\u0627\u0644\r\n  setTimeout(() => {\r\n    \/\/ \u0641\u062a\u062d \u0648\u0627\u062a\u0633 \u0622\u0628 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)\r\n    window.open(whatsappUrl, '_blank');\r\n    \r\n    \/\/ \u0625\u0638\u0647\u0627\u0631 \u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0646\u062c\u0627\u062d\r\n    successPopup.style.display = 'flex';\r\n    \r\n    \/\/ \u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646 \u0627\u0644\u0641\u0648\u0631\u0645\r\n    contactForm.reset();\r\n    submitBtn.innerHTML = originalText;\r\n    submitBtn.disabled = false;\r\n  }, 800);\r\n});\r\n\r\n\/\/ \u0625\u063a\u0644\u0627\u0642 \u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0646\u062c\u0627\u062d\r\ncloseSuccess.addEventListener('click', () => {\r\n  successPopup.style.display = 'none';\r\n});\r\n\r\n\/\/ \u0625\u063a\u0644\u0627\u0642 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u062e\u0627\u0631\u062c \u0627\u0644\u0646\u0627\u0641\u0630\u0629\r\nsuccessPopup.addEventListener('click', (e) => {\r\n  if(e.target === successPopup) {\r\n    successPopup.style.display = 'none';\r\n  }\r\n});\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>\u0645\u0631\u062d\u0628\u0627 \u0628\u0643\u0645 \u0641\u064a \u0627\u0644\u0632\u0647\u0631\u0627\u0621 \u0644\u0644\u0639\u0645\u0631\u0629 \u0648\u0627\u0644\u0632\u064a\u0627\u0631\u0647 \u0645\u0646 \u0646\u062d\u0646 \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0645\u0631\u062d\u0628\u