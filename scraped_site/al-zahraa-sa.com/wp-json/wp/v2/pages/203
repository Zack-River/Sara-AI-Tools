ion(e) {\r\n    const rect = this.getBoundingClientRect();\r\n    const x = e.clientX - rect.left;\r\n    const y = e.clientY - rect.top;\r\n    const centerX = rect.width \/ 2;\r\n    const centerY = rect.height \/ 2;\r\n    const rotateX = (y - centerY) \/ 20;\r\n    const rotateY = (centerX - x) \/ 20;\r\n    \r\n    this.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-10px)`;\r\n    \r\n    const icon = this.querySelector('.card-icon');\r\n    if(icon) {\r\n      icon.style.transform = `rotateX(${rotateX * 0.5}deg) rotateY(${rotateY * 0.5}deg) scale(1.05)`;\r\n      icon.style.boxShadow = `0 20px 40px -8px rgba(0,0,0,0.5), 0 0 20px rgba(197,173,124,0.4)`;\r\n    }\r\n  });\r\n  \r\n  card.addEventListener('mouseleave', function() {\r\n    this.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';\r\n    const icon = this.querySelector('.card-icon');\r\n    if(icon) {\r\n      icon.style.transform = 'rotateX(0deg) rotateY(0deg) scale(1)';\r\n      icon.style.boxShadow = '0 15px 35px -5px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1)';\r\n    }\r\n  });\r\n});\r\n<\/script>\r\n\r\n<style>\r\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap');\r\n  \r\n  * {\r\n    margin: 0;\r\n    padding: 0;\r\n    box-sizing: border-box;\r\n  }\r\n  \r\n  @keyframes proPulse1 {\r\n    0%,100% { transform: scale(1); opacity:0.15; }\r\n    50% { transform: scale(1.2); opacity:0.25; }\r\n  }\r\n  @keyframes proPulse2 {\r\n    0%,100% { transform: scale(1); opacity:0.1; }\r\n    50% { transform: scale(1.25); opacity:0.2; }\r\n  }\r\n  @keyframes proPulse3 {\r\n    0%,100% { transform: translate(-50%,-50%) scale(1); opacity:0.08; }\r\n    50% { transform: translate(-50%,-50%) scale(1.3); opacity:0.15; }\r\n  }\r\n  @keyframes proFadeUp {\r\n    0% { opacity:0; transform:translateY(40px) }\r\n    100% { opacity:1; transform:translateY(0)